VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Required for native builds because /api is hosted by Vercel, not in the app bundle.
VITE_API_BASE_URL=https://app.diaspora-direct.com

# Server-side only. Add these in Vercel; never expose or commit the real key.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
APP_PUBLIC_URL=https://app.diaspora-direct.com
